# Local SDKs and tool caches (keep SDK version configuration)
.fvm/
__pycache__/
.pytest_cache/
.venv/
venv/

# Downloaded geographic source data; not used by the bundled app
/assets/planet/

# Local editor / agent state (shared VS Code configuration stays tracked)
*.code-workspace
.codex/
.agents/

# Local web tooling and hosting caches
node_modules/
.vercel/
.firebase/

# Test runner output
/test-results/
/playwright-report/
